# Optional server configuration. No email service or API key is needed.
# Copy to .env if needed; existing process environment takes precedence.
# Local HTTP preview:
BAKERY_SECURE_COOKIE=0
# Set to 1 only when the site is served over HTTPS.

# Owner Web Push: use your actual HTTPS site URL OR contact email (no email is sent).
# BAKERY_PUSH_SUBJECT=https://your-bakery-domain.example
# BAKERY_PUSH_SUBJECT=mailto:your-real-contact@example.com
# VAPID keys are generated privately in data/push-private.pem. Keep them backed up.
